// Resource script (ASCII only so that both rc.exe and windres accept it)
#include <windows.h>
#include "resource.h"

IDI_APP ICON "app.ico"

// Manifest: Common Controls v6, Per-Monitor V2 DPI awareness, asInvoker
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_NUM
 PRODUCTVERSION APP_VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104b0"
        BEGIN
            VALUE "FileDescription", "Auto Clicker"
            VALUE "FileVersion", APP_VERSION_STR
            VALUE "InternalName", "AutoClicker"
            VALUE "OriginalFilename", "AutoClicker.exe"
            VALUE "ProductName", "Auto Clicker"
            VALUE "ProductVersion", APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x411, 1200
    END
END
